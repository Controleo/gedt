# Copy this file to .env and fill in the values. Never commit .env to GitHub.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/gedt_dev
PORT=3000
# Any long random text (16 characters or more). Used to sign login tokens.
JWT_SECRET=replace-with-a-long-random-text
# Key used by the simulated monitoring feed. Leave empty to switch the feed off.
SIM_FEED_KEY=replace-with-another-random-text
# true shows demonstration login buttons on the sign-in page. Set to false for a real deployment.
DEMO_MODE=true
# Distance in metres for "near the cut" (default 100)
CORRIDOR_M=100
# console prints alert emails in the terminal. smtp sends real emails.
EMAIL_MODE=console
EMAIL_FROM=alerts@gedt.example
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
