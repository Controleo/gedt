{
  "name": "gedt-prototype",
  "version": "0.2.0",
  "private": true,
  "description": "GEDT prototype: shared geospatial registry for telecom operators",
  "main": "server/src/server.js",
  "scripts": {
    "start": "node server/src/server.js",
    "dev": "node --watch server/src/server.js",
    "db:load": "node server/scripts/load-db.js",
    "test": "node --test server/tests/api.test.js",
    "test:ui": "python server/tests/ui_smoke_test.py",
    "simulate": "node server/scripts/simulate-cut.js",
    "db:ensure": "node server/scripts/load-db.js --if-empty",
    "backup": "node server/scripts/backup-note.js",
    "db:eval": "node server/scripts/run-sql.js database/seed_evaluation.sql"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "dotenv": "^18.0.7",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1"
  }
}
